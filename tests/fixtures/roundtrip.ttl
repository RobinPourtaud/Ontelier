@prefix : <https://example.org/test#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:Person a owl:Class; rdfs:label "Personne"@fr, "Person"@en;
  :custom [ :unknown "42"^^xsd:integer ];
  owl:equivalentClass [ owl:intersectionOf ( :Human [ owl:complementOf :Robot ] ) ] .
:Human a owl:Class . :Robot a owl:Class .
:Alice a owl:NamedIndividual, :Person; :birthday "1984-04-01"^^xsd:date .
