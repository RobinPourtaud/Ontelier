{
  "name": "ontelier",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/vendor.mjs && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy --config wrangler.local.jsonc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Robin Pourtaud",
  "license": "MIT",
  "description": "A browser-native, local-first ontology IDE with real OWL reasoning.",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@rdfjs/dataset": "^2.0.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.57.0",
    "monaco-editor": "^0.57.0",
    "n3": "^1.26.0",
    "oxigraph": "^0.5.11",
    "rdf-reasoner-konclude": "^0.7.2",
    "rdf-validate-shacl": "^0.6.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rdfjs/types": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.5",
    "@types/rdfjs__dataset": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
